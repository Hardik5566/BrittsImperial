        <script>
            function biSubmitSiteSearch() {
                var input = document.getElementById('biHeaderSearchInput');
                if (!input) return;
                var q = input.value.replace(/^\s+|\s+$/g, '');
                if (!q) return;
                window.location.href = 'Search.aspx?q=' + encodeURIComponent(q);
            }

            (function () {
                var input = document.getElementById('biHeaderSearchInput');
                if (!input) return;
                input.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter' || e.keyCode === 13) {
                        e.preventDefault();
                        biSubmitSiteSearch();
                    }
                });
            })();

            (function ($) {
                $(document).ready(function () {
                    var $navMenu = $('#navbar-menu');
                    var $topSearch = $('.top-search');

                    $('.attr-nav .search > a').on('click', function () {
                        if ($navMenu.hasClass('in')) {
                            $navMenu.collapse('hide');
                        }
                    });

                    $('.navbar-toggle').on('click', function () {
                        if ($topSearch.is(':visible')) {
                            $topSearch.stop(true, true).slideUp(200);
                        }
                    });

                    $navMenu.on('shown.bs.collapse hidden.bs.collapse', function () {
                        var expanded = $navMenu.hasClass('in');
                        $('.navbar-toggle').attr('aria-expanded', expanded ? 'true' : 'false');
                    });
                });
            })(jQuery);
        </script>

